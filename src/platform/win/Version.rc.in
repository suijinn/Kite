// ビルドのたびに cmake/GitVersion.cmake が生成する（手編集しないこと）。
//
// kite.exe と kite_shellhost.exe の両方がこの 1 枚から作られる。違うのは名前と
// 説明、そしてアイコンを持つかどうかだけ。
//
// 版とコミットの出どころは Version.h と同じ ─ 別々に組み立てると、プロパティ画面と
// 画面上の表示が食い違う日が必ず来る。
#include <windows.h>

#include "platform/win/Resources.h"

@KITE_RC_ICON@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @KITE_VERSION_MAJOR@,@KITE_VERSION_MINOR@,@KITE_VERSION_PATCH@,0
 PRODUCTVERSION @KITE_VERSION_MAJOR@,@KITE_VERSION_MINOR@,@KITE_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904B0 = 英語 (米国) / Unicode。値そのものが英語なので、日本語環境でも
        // この 1 ブロックだけを置く（言語ごとに違う文字列を持たせる予定は無い）。
        BLOCK "040904B0"
        BEGIN
            // 発行者を名乗る 2 行。無署名の趣味プロジェクトにできる数少ない
            // «素性を明かす» 手段で、Defender の機械学習分類器が Kite を
            // Trojan:Win32/Bearfoos.B!ml と誤検知した後に足した ─ 「発行者不明・
            // 未署名・初見のハッシュ」の 3 つ揃いを 1 つ減らす。**これで誤検知が
            // 止まる保証は無い**（止める手段はコード署名しかない）が、嘘ではない
            // 情報を書き足す代金はゼロ。
            //
            // 年は手で上げる。ビルド時に差し込むと、版とコミットの出どころが
            // 増える割に、誰も読まない 4 桁のために毎年 1 月 1 日に全体が
            // 再コンパイルされる。
            VALUE "CompanyName", "suijinn"
            VALUE "FileDescription", "@KITE_RC_DESCRIPTION@"
            VALUE "FileVersion", "@KITE_VERSION@ (@KITE_GIT_COMMIT@)"
            VALUE "InternalName", "@KITE_RC_NAME@"
            VALUE "LegalCopyright", "Copyright (C) 2026 suijinn"
            VALUE "OriginalFilename", "@KITE_RC_NAME@.exe"
            VALUE "ProductName", "Kite"
            VALUE "ProductVersion", "@KITE_VERSION@ (@KITE_GIT_COMMIT@)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
